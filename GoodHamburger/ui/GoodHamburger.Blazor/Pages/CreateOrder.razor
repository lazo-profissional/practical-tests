@page "/orders/create"
@using GoodHamburger.Blazor.Models
@inject GoodHamburger.Blazor.Services.ApiClient ApiClient
@inject NavigationManager Navigation

<h1>Create Order</h1>

@if (menuItems == null)
{
    <p>Loading...</p>
}
else
{
    <div class="mb-3">
        <h4>Select Items</h4>
        <p class="text-muted">Max: 1 Sandwich, 1 Side, 1 Drink</p>
        
        <h5>Sandwiches</h5>
        @foreach (var item in menuItems.Where(m => m.Type == "Sandwich"))
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" 
                       id="sandwich-@item.Id" 
                       @onchange="e => ToggleItem(item.Id, item.Type, (bool)(e.Value ?? false))" />
                <label class="form-check-label" for="sandwich-@item.Id">
                    @item.Name - @item.Price.ToString("C")
                </label>
            </div>
        }

        <h5 class="mt-3">Sides</h5>
        @foreach (var item in menuItems.Where(m => m.Type == "Side"))
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" 
                       id="side-@item.Id" 
                       @onchange="e => ToggleItem(item.Id, item.Type, (bool)(e.Value ?? false))" />
                <label class="form-check-label" for="side-@item.Id">
                    @item.Name - @item.Price.ToString("C")
                </label>
            </div>
        }

        <h5 class="mt-3">Drinks</h5>
        @foreach (var item in menuItems.Where(m => m.Type == "Drink"))
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" 
                       id="drink-@item.Id" 
                       @onchange="e => ToggleItem(item.Id, item.Type, (bool)(e.Value ?? false))" />
                <label class="form-check-label" for="drink-@item.Id">
                    @item.Name - @item.Price.ToString("C")
                </label>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <button class="btn btn-primary" @onclick="PlaceOrder" disabled="@(selectedIds.Count == 0)">Place Order</button>
    <a href="/orders" class="btn btn-secondary ms-2">Cancel</a>
}

@code {
    private List<MenuItemModel>? menuItems;
    private List<int> selectedIds = new();
    private string? errorMessage;
    private Dictionary<string, int> typeCounts = new()
    {
        ["Sandwich"] = 0,
        ["Side"] = 0,
        ["Drink"] = 0
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            menuItems = await ApiClient.GetMenuAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load menu: {ex.Message}";
        }
    }

    private void ToggleItem(int id, string type, bool isSelected)
    {
        if (isSelected)
        {
            if (typeCounts[type] >= 1)
            {
                errorMessage = $"Cannot add more than 1 {type}.";
                return;
            }
            selectedIds.Add(id);
            typeCounts[type]++;
        }
        else
        {
            selectedIds.Remove(id);
            typeCounts[type]--;
        }
        errorMessage = null;
    }

    private async Task PlaceOrder()
    {
        try
        {
            var order = new CreateOrderModel { MenuItemIds = selectedIds };
            var result = await ApiClient.CreateOrderAsync(order);
            if (result != null)
                Navigation.NavigateTo("/orders");
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"An unexpected error occurred: {ex.Message}";
        }
    }
}