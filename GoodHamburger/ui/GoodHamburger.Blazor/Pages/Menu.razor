@page "/menu"
@using GoodHamburger.Blazor.Models
@inject GoodHamburger.Blazor.Services.ApiClient ApiClient

<h1>Menu</h1>

@if (menuItems == null)
{
    <p>Loading...</p>
}
else if (!menuItems.Any())
{
    <p>No menu items available.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in menuItems)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Type</td>
                    <td>@item.Price.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<MenuItemModel>? menuItems;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            menuItems = await ApiClient.GetMenuAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading menu: {ex.Message}");
        }
    }
}